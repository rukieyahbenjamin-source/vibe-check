{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Little World",
  "version": "0.1.0",
  "identifier": "com.littleworld.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Little World",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "shortDescription": "A cosy desktop decorating game for a little world of your own.",
    "longDescription": "Little World is a cosy desktop decorating game. Place flowers, trees, ponds and cottage details on a floating island, unlock new items through daily goals and milestones, and keep your world saved on your computer.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
